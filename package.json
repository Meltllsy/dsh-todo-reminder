{
  "name": "dsh-todo-reminder",
  "version": "0.1.2",
  "description": "DSH 全局个人待办插件：侧边栏「待办」面板 + 右侧待办条（悬停探出 / 快到点自动弹开）+ 到期提醒（自定义音效）+ 完成需确认，另给 agent 提供 todo_* 工具。与 DSH 会话无关。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.0",
    "@types/react-dom": "~18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "prepack": "npm run build && npm run build:client",
    "check:compat": "node scripts/check-compat.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "todo",
    "reminder",
    "notification",
    "待办",
    "提醒"
  ],
  "author": "Meltllsy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meltllsy/dsh-todo-reminder.git"
  },
  "homepage": "https://github.com/Meltllsy/dsh-todo-reminder#readme",
  "bugs": {
    "url": "https://github.com/Meltllsy/dsh-todo-reminder/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
